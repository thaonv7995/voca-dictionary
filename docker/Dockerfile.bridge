# Local API bridge: create-card stream, TTS cache, audio files (port 22053).
FROM node:22-bookworm-slim

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /pw
COPY docker/bridge/package.json ./

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install \
  && npx playwright install-deps chromium \
  && npx playwright install chromium \
  && npm cache clean --force

WORKDIR /app
COPY skills/scripts/voca-local-api.mjs skills/scripts/voca-create-card.mjs ./skills/scripts/
COPY packages/voca-core/src/auth/token.ts ./packages/voca-core/src/auth/token.ts

ENV VOCA_REPO_ROOT=/voca-data
ENV VOCA_PLAYWRIGHT_HOME=/pw
ENV VOCA_BIND_ADDRESS=0.0.0.0
ENV VOCA_LOCAL_API_PORT=22053

EXPOSE 22053

CMD ["node", "skills/scripts/voca-local-api.mjs"]
