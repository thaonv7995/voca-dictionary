{
  "name": "voca-dictionary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:all": "concurrently -k -n bridge,web -c cyan,magenta npm:voca:api npm:dev",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "voca:api": "node skills/scripts/voca-local-api.mjs",
    "test:api": "node --test skills/scripts/voca-local-api.api-test.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "validate:data": "node skills/scripts/validate-manifest.mjs",
    "gen:theme": "node skills/scripts/generate-theme-colors.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
