{
  "expo": {
    "name": "Voca Mobile",
    "slug": "voca-mobile",
    "scheme": "voca-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.voca.dictionary.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSCameraUsageDescription": "Chụp ảnh để scan từ vựng cần học.",
        "NSPhotoLibraryUsageDescription": "Chọn ảnh để nhận diện từ vựng.",
        "NSSpeechRecognitionUsageDescription": "Nhận dạng giọng nói để nhập từ vựng nhanh hơn.",
        "NSMicrophoneUsageDescription": "Dùng mic để nhập từ bằng giọng nói.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.voca.action.addWord",
            "UIApplicationShortcutItemTitle": "Thêm từ mới",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeAdd"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withIosExtensions",
      "expo-speech-recognition",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5dbfeb1-15d3-4f6c-86a9-23eb11b8f42c"
      }
    },
    "owner": "thaonv795"
  }
}
