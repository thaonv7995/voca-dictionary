{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "eas:init": "npx eas-cli@latest init",
    "build:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:prod": "npx eas-cli@latest build --platform ios --profile production",
    "prebuild:ios": "expo prebuild --platform ios --clean"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "^55.0.14",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.6",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
